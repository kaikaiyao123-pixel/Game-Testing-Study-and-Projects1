# 路径 B（VPS）环境变量示例。复制为 .env 后修改。
# docker compose 通过 --env-file deploy/vps/.env 读取。

# 对外域名（仅用于文档与 nginx server_name 提示；nginx.conf 内已用 _ 兜底）
BLOG_DOMAIN=blog.example.com

# 数据库口令（务必改为强随机值）
MYSQL_ROOT_PASSWORD=change_me_root_strong
MYSQL_PASSWORD=change_me_blog_strong

# Redis 口令（务必改为强随机值）
REDIS_PASSWORD=change_me_redis_strong
